<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aaiagent 客户看板</title>
<style>
:root {
  color-scheme: light;
  --bg: #f0f9ff;
  --panel: #ffffff;
  --panel-soft: #f8fafc;
  --line: #e0f2fe;
  --line-soft: #eaf7ff;
  --text: #0f172a;
  --muted: #64748b;
  --muted-soft: #94a3b8;
  --green: #0ea5e9;
  --green-dark: #0369a1;
  --green-soft: #e0f2fe;
  --blue: #0ea5e9;
  --blue-text: #075985;
  --blue-soft: #e0f2fe;
  --warning: #f59e0b;
  --warning-soft: #fff7e6;
  --danger: #ef4444;
  --danger-text: #b91c1c;
  --danger-soft: #fff1f2;
  --purple: #38bdf8;
  --purple-soft: #eaf8ff;
  --shadow: 0 2px 8px rgba(14, 165, 233, .08);
}
* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; margin: 0; }
body {
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.5 system-ui, -apple-system, "Segoe UI", "Inter", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  font-variant-numeric: tabular-nums;
}
button, input, textarea, select { font: inherit; }
button { cursor: pointer; }
[hidden] { display: none !important; }
button:disabled { opacity: .46; cursor: not-allowed; }
button:focus-visible,
select:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}
input, select, textarea {
  width: 100%;
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 9px 10px;
  outline: 0;
  background: var(--panel);
  color: var(--text);
  transition: border-color .15s, box-shadow .15s;
}
textarea { resize: vertical; }
input:focus, select:focus, textarea:focus {
  border-color: var(--blue);
  box-shadow: 0 0 0 3px rgba(14, 165, 233, .12);
}
input::placeholder, textarea::placeholder { color: var(--muted); }

.button,
.primary-button,
.ghost-button,
.danger-button,
.icon-button {
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 8px 16px;
  background: var(--panel);
  color: var(--text);
  font-weight: 600;
  font-size: 13px;
  white-space: nowrap;
  box-shadow: 0 1px 3px rgba(14, 165, 233, .06);
  transition: all .15s ease;
}
.button:hover,
.ghost-button:hover,
.icon-button:hover { border-color: #7dd3fc; background: #f0f9ff; transform: translateY(-1px); box-shadow: 0 3px 8px rgba(14, 165, 233, .12); }
.button:active,
.ghost-button:active,
.primary-button:active { transform: translateY(0); box-shadow: 0 1px 2px rgba(14, 165, 233, .08); }
.primary-button {
  border: 0;
  background: linear-gradient(135deg, #38bdf8, #0284c7);
  color: #fff;
  box-shadow: 0 2px 8px rgba(14, 165, 233, .3);
}
.primary-button:hover { background: linear-gradient(135deg, #0ea5e9, #0369a1); color: #fff; box-shadow: 0 4px 14px rgba(14, 165, 233, .4); transform: translateY(-1px); }
.danger-button { border-color: #fecdd3; color: var(--danger-text); background: var(--danger-soft); }
.danger-button:hover { border-color: var(--danger); background: #ffe4e6; }
.icon-button { width: 38px; padding: 0; }
.small-button { min-height: 32px; padding: 5px 11px; font-size: 12px; border-radius: 7px; }
.text-button {
  border: 0;
  padding: 2px 0;
  background: transparent;
  color: var(--green-dark);
  font-weight: 700;
}

.login-layer {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 24px;
  background: var(--bg);
}
.login-card {
  width: min(420px, 100%);
  padding: 32px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--panel);
  box-shadow: 0 8px 30px rgba(14, 165, 233, .12);
}
.login-brand { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
.brand-mark {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(135deg, #38bdf8, #0ea5e9);
  color: #fff;
  font-weight: 800;
}
.login-card h1 { margin: 0; font-size: 21px; }
.login-card p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
.login-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
.login-error { min-height: 20px; margin-top: 10px; color: var(--danger-text); font-size: 12px; }

.app {
  width: 100vw;
  height: 100dvh;
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  overflow: hidden;
}
.app-sidebar {
  min-width: 0;
  display: flex;
  flex-direction: column;
  border-right: 1px solid var(--line);
  background: var(--panel);
}
.app-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 70px;
  padding: 14px 16px;
  border-bottom: 1px solid var(--line-soft);
}
.app-brand strong { display: block; font-size: 15px; }
.app-brand span { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; }
.page-nav { display: grid; gap: 4px; padding: 14px 10px; }
.page-nav button {
  width: 100%;
  min-height: 42px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 0;
  border-radius: 9px;
  padding: 0 14px;
  background: transparent;
  color: var(--muted);
  text-align: left;
  font-weight: 600;
  font-size: 13px;
  transition: all .15s ease;
}
.nav-icon {
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.page-nav button:hover { background: var(--blue-soft); color: var(--blue-text); }
.page-nav button.on { background: linear-gradient(135deg, #e0f2fe, #bae6fd); color: var(--blue-text); font-weight: 700; box-shadow: inset 3px 0 0 var(--blue); }
.sidebar-tools {
  display: grid;
  gap: 7px;
  margin-top: auto;
  padding: 12px 10px 14px;
  border-top: 1px solid var(--line-soft);
}
.sidebar-tools button {
  min-height: 38px;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: var(--muted);
  text-align: left;
  padding: 0 11px;
}
.sidebar-tools button:hover { background: var(--panel-soft); color: var(--text); }
.app-main { min-width: 0; min-height: 0; overflow: hidden; }
.page-panel { display: none; width: 100%; height: 100%; min-height: 0; }
.page-panel.on { display: block; }

.session-layout {
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: 320px minmax(420px, 1fr) 300px;
  gap: 12px;
  padding: 12px;
}
.panel {
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--panel);
  box-shadow: 0 2px 10px rgba(14, 165, 233, .05);
}
.customer-panel { display: flex; flex-direction: column; }
.panel-head {
  padding: 15px 15px 13px;
  border-bottom: 1px solid var(--line-soft);
}
.panel-title-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.panel-title-row h2,
.page-head h2 { margin: 0; font-size: 16px; }
.panel-title-row p,
.page-head p { margin: 3px 0 0; color: var(--muted); font-size: 12px; }
.filters { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 36px; gap: 7px; margin-top: 13px; }
.filters .wide { grid-column: 1 / -1; }
.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  color: var(--muted);
  font-size: 12px;
}
.customer-list { min-height: 0; overflow: auto; padding: 7px; }
.customer {
  width: 100%;
  display: grid;
  grid-template-columns: 40px minmax(0, 1fr) auto;
  gap: 9px;
  align-items: center;
  padding: 10px 9px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: inherit;
  text-align: left;
}
.customer:hover { background: var(--panel-soft); }
.customer.active { background: var(--green-soft); box-shadow: inset 3px 0 0 var(--green); }
.avatar {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: var(--panel-soft);
  color: #505664;
  font-weight: 800;
}
.customer.active .avatar { background: #bae6fd; color: var(--blue-text); }
.customer-main { min-width: 0; }
.customer-name-row { display: flex; align-items: center; gap: 6px; min-width: 0; }
.customer-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 750; }
.customer-preview { display: block; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 12px; }
.customer-meta { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; color: var(--muted-soft); font-size: 12px; }
.count-pill { padding: 1px 6px; border-radius: 999px; background: var(--panel-soft); color: var(--muted); }
.priority-dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; background: var(--warning); }
.platforms { display: inline-flex; gap: 3px; flex: 0 0 auto; }
.pf {
  width: 17px;
  height: 17px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--panel-soft);
  color: var(--muted);
  font-size: 8px;
  font-weight: 800;
}
.pf.on.soul { background: #25b8a2; color: #fff; }
.pf.on.qq { background: #238be6; color: #fff; }
.pf.on.immomo { background: #f59e0b; color: #fff; }
.pf.on.lianxin { background: #10a86a; color: #fff; }

.chat { display: flex; flex-direction: column; }
.chat-head {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 13px 16px;
  border-bottom: 1px solid var(--line-soft);
}
.chat-title-wrap { min-width: 0; }
.chat-title-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
.chat-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18px; font-weight: 800; }
.chat-subtitle { margin-top: 4px; color: var(--muted); font-size: 12px; }
.alias-strip { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 7px; }
.alias-chip { padding: 3px 8px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); color: var(--muted); font-size: 12px; }
.alias-chip.active { border-color: #7dd3fc; background: var(--blue-soft); color: var(--blue-text); }
.chat-actions { display: flex; align-items: center; justify-content: flex-end; gap: 7px; flex-wrap: wrap; }
.action-status { min-width: 76px; color: var(--muted); font-size: 12px; text-align: right; }
.priority-button.active { border-color: #f2d09b; background: var(--warning-soft); color: #9a5c08; }
.mobile-menu-button,
.mobile-profile-button { display: none; }
.messages { flex: 1; min-height: 0; overflow: auto; padding: 22px 24px 26px; background: #f0f9ff; }
.date-separator { display: flex; align-items: center; gap: 10px; margin: 17px 0; color: var(--muted-soft); font-size: 12px; text-align: center; }
.date-separator::before, .date-separator::after { content: ""; height: 1px; flex: 1; background: var(--line-soft); }
.message-row { display: flex; margin: 10px 0; }
.message-row.self { justify-content: flex-end; }
.message-block { max-width: min(700px, 70%); }
.bubble {
  padding: 10px 13px;
  border: 1px solid var(--line);
  border-radius: 8px 8px 8px 3px;
  background: var(--panel);
  box-shadow: 0 2px 8px rgba(20, 22, 31, .035);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.self .bubble { border-color: #7dd3fc; background: var(--blue-soft); border-radius: 8px 8px 3px 8px; }
.message-meta { display: flex; gap: 6px; margin-top: 4px; color: var(--muted-soft); font-size: 9px; }
.self .message-meta { justify-content: flex-end; }
.platform-label,
.source-label,
.kind-label,
.content-chip { padding: 1px 5px; border-radius: 5px; }
.platform-label { background: var(--blue-soft); color: #187da8; }
.source-label { background: var(--panel-soft); }
.kind-label { background: var(--green-soft); color: var(--green-dark); }
.kind-label.kind-first_observed { background: var(--warning-soft); color: var(--warning); }
.kind-label.kind-ai_generated, .kind-label.kind-manual { background: var(--purple-soft); color: #5d3fe6; }
.kind-label.kind-derived { background: #f7eef7; color: #8a5a88; }
.content-bubble { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
.content-chip { background: var(--panel-soft); border: 1px solid var(--line); color: var(--muted); font-size: 12px; }
.content-rest { color: var(--text); }
.composer { padding: 11px 14px 13px; border-top: 1px solid var(--line-soft); background: var(--panel); }
.composer-box {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 9px;
  padding: 8px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel-soft);
}
.composer-box:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(14, 165, 233, .12); }
.composer textarea {
  min-height: 42px;
  max-height: 110px;
  padding: 5px 7px;
  border: 0;
  background: transparent;
  box-shadow: none;
  resize: vertical;
}
.composer-note { margin-top: 6px; color: var(--muted-soft); font-size: 12px; }

.profile-panel { display: flex; flex-direction: column; overflow: auto; }
.profile-head { padding: 15px; border-bottom: 1px solid var(--line-soft); }
.profile-head h2 { margin: 0; font-size: 15px; }
.profile-head p { margin: 3px 0 0; color: var(--muted); font-size: 12px; }
.profile-hero { padding: 17px 15px 15px; text-align: center; }
.profile-hero .avatar { width: 54px; height: 54px; margin: 0 auto 9px; font-size: 19px; border-radius: 8px; }
.profile-hero h3 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 16px; }
.profile-hero p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
.profile-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; padding: 0 15px; }
.stat { padding: 10px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel-soft); text-align: center; }
.stat strong { display: block; color: var(--blue-text); font-size: 17px; }
.stat span { color: var(--muted); font-size: 12px; }
.profile-section { padding: 15px; border-top: 1px solid var(--line-soft); }
.profile-section h4 { margin: 0 0 10px; color: var(--muted); font-size: 12px; }
.profile-updated { margin-left: 5px; color: var(--muted-soft); font-size: 9px; font-weight: 400; }
.profile-info { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--line-soft); font-size: 12px; }
.profile-info:last-child { border-bottom: 0; }
.profile-info span { color: var(--muted); }
.profile-info b { max-width: 64%; text-align: right; font-weight: 600; }
.profile-actions { display: flex; gap: 7px; }
.profile-actions button { flex: 1; }
.platform-links { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
.platform-link { padding: 8px 3px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel); color: var(--muted); text-align: center; font-size: 12px; }
.platform-link.on { border-color: #7dd3fc; background: var(--blue-soft); color: var(--blue-text); cursor: pointer; }
.platform-link b { display: block; margin-bottom: 2px; font-size: 12px; }
.contact-flags { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }
.contact-flag { padding: 3px 8px; border: 1px solid #fecdd3; border-radius: 999px; background: var(--danger-soft); color: var(--danger-text); font-size: 12px; }
.contact-flag.warn { border-color: #f2d09b; background: var(--warning-soft); color: #8d5b0d; }
.flag-none { color: var(--muted-soft); font-size: 12px; }
.flag-restore { border: 1px solid var(--line); border-radius: 6px; padding: 3px 8px; background: var(--panel); color: var(--green-dark); font-size: 12px; }
.takeover-list { display: flex; flex-direction: column; gap: 5px; max-height: 170px; overflow: auto; }
.takeover-item { padding: 7px 8px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel-soft); }
.takeover-item b { display: block; color: #a73539; font-size: 12px; }
.takeover-item p { margin: 3px 0 0; color: #505664; font-size: 12px; overflow-wrap: anywhere; }
.takeover-item span { color: var(--muted-soft); font-size: 9px; }
.waiting-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 3px 8px; padding: 8px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel-soft); }
.waiting-item b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.waiting-item span { grid-column: 1; color: var(--muted); font-size: 12px; }
.waiting-item button { grid-column: 2; grid-row: 1 / span 2; border: 1px solid var(--line); border-radius: 6px; background: var(--panel); color: var(--green-dark); font-size: 12px; }

.page-shell { height: 100%; min-height: 0; overflow: auto; padding: 22px; }
.page-inner { max-width: 1480px; margin: 0 auto; }
.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 14px; }
.page-head h2 { font-size: 22px; font-weight: 700; color: var(--text); }
.page-head p { font-size: 13px; margin-top: 5px; }
.toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.toolbar label { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; }
.toolbar select { width: auto; min-width: 130px; }
.empty-panel {
  min-height: 180px;
  display: grid;
  place-items: center;
  border: 1px dashed #d9dde4;
  border-radius: 8px;
  background: rgba(255, 255, 255, .55);
  color: var(--muted);
  text-align: center;
}

.gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
.library-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  box-shadow: 0 4px 16px rgba(20, 22, 31, .045);
}
.library-cover {
  position: relative;
  aspect-ratio: 16 / 9;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: var(--panel-soft);
  color: var(--muted-soft);
}
.library-cover img { width: 100%; height: 100%; object-fit: cover; }
.library-cover .empty-cover { font-size: 12px; }
.cover-actions { position: absolute; right: 8px; bottom: 8px; display: flex; gap: 5px; }
.cover-actions button { border: 1px solid rgba(255, 255, 255, .7); border-radius: 6px; padding: 4px 7px; background: rgba(20, 22, 31, .72); color: #fff; font-size: 12px; }
.library-body { padding: 12px; }
.library-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.library-title-row h3 { margin: 0; font-size: 15px; }
.status-chip { padding: 2px 7px; border-radius: 999px; background: var(--panel-soft); color: var(--muted); font-size: 12px; white-space: nowrap; }
.status-chip.on { background: var(--green-soft); color: var(--green-dark); }
.library-keywords { min-height: 34px; margin: 8px 0; color: var(--muted); font-size: 12px; line-height: 1.55; }
.library-meta { color: var(--muted-soft); font-size: 12px; }
.library-actions { display: flex; gap: 7px; margin-top: 12px; }
.library-actions button { flex: 1; }

.agent-overview-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; margin-bottom: 12px; }
.agent-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
.agent-summary-row { padding: 8px 9px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--panel-soft); }
.agent-summary-row span { display: block; color: var(--muted); font-size: 12px; }
.agent-summary-row b { display: block; margin-top: 2px; font-size: 12px; overflow-wrap: anywhere; }
.conflict-list, .locked-rule-list, .prompt-order { display: grid; gap: 8px; }
.legacy-rules-card { margin-top: 0; }
.legacy-rule-list { display: grid; gap: 10px; }
.legacy-rule { padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); box-shadow: 0 1px 4px rgba(14, 165, 233, .04); transition: all .15s ease; }
.legacy-rule:hover { border-color: #7dd3fc; box-shadow: 0 4px 12px rgba(14, 165, 233, .1); }
.legacy-rule-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.legacy-rule-head b { font-size: 14px; font-weight: 700; color: var(--text); line-height: 1.4; }
.legacy-rule-tags { display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; }
.legacy-tag { padding: 3px 9px; border-radius: 999px; background: var(--panel-soft); color: var(--muted); font-size: 11px; font-weight: 600; white-space: nowrap; }
.legacy-tag.keep { background: #e0f2fe; color: var(--blue-text); }
.legacy-tag.move { background: var(--blue-soft); color: #187da8; }
.legacy-tag.review { background: var(--warning-soft); color: var(--warning); }
.legacy-rule p { margin: 8px 0 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
.legacy-rule small { display: block; margin-top: 8px; color: var(--muted-soft); font-size: 11px; overflow-wrap: anywhere; }
.conflict-item, .locked-rule, .prompt-order-row { padding: 9px 10px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--panel-soft); }
.conflict-item.error { border-color: #efc4c6; background: var(--danger-soft); }
.conflict-item.warn { border-color: #f2d09b; background: var(--warning-soft); }
.conflict-item.ok { border-color: #bae6fd; background: #f0f9ff; }
.isolated-ok, .isolated-warn, .isolated-error { margin-bottom: 8px; padding: 9px 10px; border-radius: 7px; font-size: 12px; font-weight: 700; }
.isolated-ok { color: #0369a1; background: #f0f9ff; }
.isolated-warn { color: var(--warning); background: var(--warning-soft); }
.isolated-error { color: var(--danger-text); background: var(--danger-soft); }
.legacy-rule.off { opacity: .62; }
.rule-actions { margin-top: 8px; }
.danger-text { color: var(--danger-text); }

/* 规则中心：把总览、规则、冲突、人设资料和手机动作分开 */
.rule-center-shell { display: grid; gap: 16px; min-width: 0; max-width: 100%; }
.rule-center-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 22px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--panel);
  box-shadow: 0 2px 12px rgba(14, 165, 233, .06);
  min-width: 0;
}
.rule-center-head h2 { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: 0; }
.rule-center-head p { margin: 6px 0 0; color: var(--muted); font-size: 13px; }
.rule-search {
  min-width: min(360px, 34vw);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 11px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(14, 165, 233, .06);
}
.rule-search svg {
  width: 16px;
  height: 16px;
  flex: 0 0 16px;
  fill: none;
  stroke: var(--blue-text);
  stroke-width: 1.8;
  stroke-linecap: round;
}
.rule-search input {
  border: 0;
  padding: 9px 0;
  background: transparent;
  box-shadow: none;
}
.rule-center-head-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.rule-center-layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 16px; align-items: start; min-width: 0; max-width: 100%; }
.rule-center-nav {
  position: sticky;
  top: 12px;
  display: grid;
  gap: 6px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--panel);
  box-shadow: 0 2px 8px rgba(14, 165, 233, .05);
  min-width: 0;
  max-width: 100%;
}
.rule-nav-button {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border: 1px solid transparent;
  border-radius: 10px;
  padding: 10px 12px;
  background: transparent;
  color: var(--muted);
  font-weight: 600;
  font-size: 13px;
  text-align: left;
  transition: all .15s ease;
}
.rule-nav-button:hover { background: var(--blue-soft); color: var(--blue-text); }
.rule-nav-button.on {
  background: linear-gradient(135deg, #e0f2fe, #bae6fd);
  color: var(--blue-text);
  font-weight: 700;
  box-shadow: inset 3px 0 0 var(--blue);
}
.rule-nav-count {
  min-width: 22px;
  padding: 2px 6px;
  border-radius: 999px;
  background: var(--panel-soft);
  color: var(--muted);
  font-size: 12px;
  text-align: center;
}
.rule-nav-button.on .rule-nav-count { background: var(--panel); color: var(--green-dark); }
.rule-nav-count.alert { background: var(--danger-soft); color: var(--danger-text); }
.rule-center-main { min-width: 0; max-width: 100%; display: grid; gap: 14px; }
.rule-tab-panel { display: none; }
.rule-tab-panel.on { display: grid; gap: 14px; }
.rule-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
  background: var(--panel);
  box-shadow: 0 2px 8px rgba(14, 165, 233, .05);
}
.rule-stat {
  min-height: 110px;
  padding: 16px 18px;
  border-right: 1px solid var(--line-soft);
  background: var(--panel);
  transition: background .15s;
}
.rule-stat:last-child { border-right: 0; }
.rule-stat-top { display: flex; align-items: center; gap: 7px; }
.rule-stat-top > span:last-child { color: var(--muted); font-size: 12px; }
.rule-stat-icon {
  width: 24px;
  height: 24px;
  display: inline-grid;
  place-items: center;
  border-radius: 7px;
  background: var(--blue-soft);
  color: var(--blue-text);
}
.rule-stat-icon svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.rule-stat strong { display: block; margin-top: 8px; font-size: 28px; font-weight: 700; line-height: 1; color: var(--text); }
.rule-stat small { display: block; margin-top: 8px; color: var(--muted); font-size: 12px; }
.rule-stat em { display: block; margin-top: 5px; color: var(--muted-soft); font-size: 11px; font-style: normal; }
.rule-stat.error { border-color: #fecdd3; background: var(--danger-soft); }
.rule-stat.error strong { color: var(--danger-text); }
.rule-stat.warn { border-color: #fde68a; background: var(--warning-soft); }
.rule-stat.warn strong { color: var(--warning); }
.rule-stat.ok { border-color: #bae6fd; background: #f0f9ff; }
.rule-stat.ok strong { color: var(--green-dark); }
.rule-section {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--panel);
  box-shadow: 0 2px 8px rgba(14, 165, 233, .04);
}
.rule-section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.rule-section-head h3 { margin: 0; font-size: 16px; font-weight: 700; color: var(--text); }
.rule-section-head p { margin: 5px 0 0; color: var(--muted); font-size: 12px; line-height: 1.55; }
.rule-filter-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.rule-filter-bar input[type="search"] { width: min(280px, 100%); }
.rule-filter-bar select { width: auto; min-width: 130px; }
.rule-list-grid { display: grid; grid-template-columns: 1fr; gap: 10px; align-items: start; }
.rule-card {
  display: grid;
  grid-template-columns: minmax(260px, 1.55fr) minmax(220px, .9fr) auto;
  gap: 16px;
  align-items: center;
  padding: 14px 16px;
  border: 1px solid var(--line-soft);
  border-radius: 10px;
  background: var(--panel);
  transition: border-color .15s, box-shadow .15s;
}
.rule-card:hover { border-color: #bae6fd; box-shadow: 0 2px 8px rgba(14, 165, 233, .08); }
.rule-card.off { opacity: .64; }
.rule-card.conflict-error { border-color: #efc4c6; box-shadow: 0 0 0 2px rgba(229, 72, 77, .05); }
.rule-card.conflict-warn { border-color: #f2d09b; }
.rule-card-head { grid-column: 1; display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; min-width: 0; }
.rule-card-head h4 { margin: 0; font-size: 13px; line-height: 1.45; }
.rule-card-head p { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.55; overflow-wrap: anywhere; }
.rule-details { margin-top: 5px; }
.rule-details summary {
  width: max-content;
  color: var(--blue-text);
  font-size: 12px;
  font-weight: 650;
  cursor: pointer;
}
.rule-details p {
  margin: 6px 0 0;
  padding: 9px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #f8fafc;
  color: var(--text);
  line-height: 1.65;
}
.rule-badge-row { display: flex; flex-wrap: wrap; gap: 5px; }
.rule-card > .rule-badge-row { grid-column: 2; align-content: center; }
.rule-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 7px;
  border-radius: 999px;
  background: var(--panel-soft);
  color: var(--muted);
  font-size: 12px;
  white-space: nowrap;
}
.rule-badge.on { background: var(--green-soft); color: var(--green-dark); }
.rule-badge.off { background: #f1f5f9; color: var(--muted); }
.rule-badge.error { background: var(--danger-soft); color: var(--danger-text); }
.rule-badge.warn { background: var(--warning-soft); color: var(--warning); }
.rule-badge.info { background: var(--blue-soft); color: #187da8; }
.rule-topic-group { display: grid; gap: 8px; }
.rule-topic-title { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: 8px; padding: 5px 0; background: var(--panel); color: var(--muted); font-size: 12px; font-weight: 750; }
.rule-topic-title::after { content: ""; height: 1px; flex: 1; background: var(--line-soft); }
.rule-card-actions { grid-column: 3; display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; padding-top: 0; }
.rule-conflict-list { display: grid; gap: 8px; }
.rule-conflict {
  display: block;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--panel);
}
.rule-conflict.error { border-color: #fecdd3; background: var(--danger-soft); }
.rule-conflict.warn { border-color: #fde68a; background: var(--warning-soft); }
.rule-conflict.info { border-color: #1c6a91; background: var(--blue-soft); }
.rule-conflict.muted { background: var(--panel-soft); }
.rule-conflict h4 { margin: 0; font-size: 13px; }
.rule-conflict p { margin: 5px 0 0; color: var(--muted); font-size: 12px; line-height: 1.6; }
.rule-conflict small { display: block; margin-top: 7px; color: var(--muted); font-size: 12px; }
.rule-conflict-actions { display: flex; gap: 6px; margin-top: 9px; flex-wrap: wrap; }
.rule-empty { padding: 28px 16px; border: 1px dashed var(--line); border-radius: 9px; color: var(--muted); text-align: center; font-size: 12px; }
.rule-help-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
  background: var(--panel);
}
.rule-help-item { padding: 10px 12px; border-right: 1px solid var(--line-soft); background: var(--panel); }
.rule-help-item:last-child { border-right: 0; }
.rule-help-item b { display: block; font-size: 12px; }
.rule-help-item span { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.55; }

.conflict-item b, .locked-rule b, .prompt-order-row b { display: block; font-size: 12px; }
.conflict-item p, .locked-rule p { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.55; }
.program-rules-card { margin-top: 12px; }
.program-rule-block { display: grid; gap: 9px; padding: 11px 0; border-top: 1px solid var(--line-soft); }
.program-rule-block:first-of-type { border-top: 0; padding-top: 0; }
.program-rule-block:last-of-type { padding-bottom: 0; }
.program-rule-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.program-rule-title b { display: block; font-size: 12px; }
.program-rule-title span { display: block; margin-top: 3px; color: var(--muted); font-size: 12px; line-height: 1.55; }
.program-rule-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 9px; }
.program-rule-field { display: grid; gap: 5px; color: var(--muted); font-size: 12px; }
.program-rule-field textarea { min-height: 88px; line-height: 1.55; }
.program-rule-field input, .program-rule-field select, .program-rule-field textarea { color: var(--text); }
.program-rule-markers { min-height: 150px; }
.program-rule-voice-instruction { min-height: 120px; }
.program-rule-test-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: stretch; }
.program-rule-test-result { display: grid; gap: 7px; margin-top: 9px; }
.program-rule-test-item { padding: 9px 10px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--panel-soft); }
.program-rule-test-item b { display: block; font-size: 12px; }
.program-rule-test-item p { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.55; overflow-wrap: anywhere; }
.sticker-meaning-list { display: grid; gap: 7px; }
.sticker-meaning-row { display: grid; grid-template-columns: minmax(100px, .65fr) minmax(0, 1fr) 36px; gap: 7px; }
.program-rule-help { color: var(--muted-soft); font-size: 12px; line-height: 1.5; }
.agent-editor-card { margin-bottom: 12px; }
.persona-prompt-editor { min-height: 220px; margin-top: 10px; line-height: 1.65; }
.agent-cards-section { margin: 12px 0; }
.agent-test-card { margin-top: 12px; }
.agent-test-results { display: grid; gap: 12px; margin-top: 12px; }
.agent-test-question { padding: 11px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel-soft); }
.agent-test-question > b { display: block; margin-bottom: 8px; font-size: 13px; }
.agent-test-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.agent-test-column { padding: 9px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--panel); }
.agent-test-column span { display: block; color: var(--muted); font-size: 12px; }
.agent-test-column p { margin: 5px 0 0; white-space: pre-wrap; font-size: 12px; line-height: 1.6; }
.agent-test-column.failed { border-color: #efc4c6; background: var(--danger-soft); }
.prompt-order-row { display: flex; align-items: center; gap: 9px; }
.prompt-order-row span:first-child { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 50%; background: var(--green-soft); color: var(--green-dark); font-size: 12px; font-weight: 800; }
.drawer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 12px; }
.drawer-card {
  display: grid;
  gap: 9px;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
}
.drawer-card.off { opacity: .68; }
.drawer-card-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.drawer-card-head input { font-weight: 700; }
.drawer-field { display: grid; gap: 5px; color: var(--muted); font-size: 12px; }
.drawer-field select { font-size: 12px; }
.drawer-meta-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; }
.drawer-card textarea { min-height: 94px; font-size: 12px; line-height: 1.6; }
.drawer-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.drawer-card-footer-actions { display: flex; gap: 6px; }
.switch {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 12px;
  cursor: pointer;
}
.switch input {
  position: relative;
  width: 38px;
  height: 21px;
  flex: 0 0 38px;
  border: 1px solid #bae6fd;
  border-radius: 999px;
  padding: 0;
  appearance: none;
  background: #e0f2fe;
  accent-color: var(--green);
  transition: background .15s ease, border-color .15s ease;
}
.switch input::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 4px rgba(14, 165, 233, .16);
  transition: transform .15s ease, background .15s ease;
}
.switch input:checked {
  border-color: #0ea5e9;
  background: #0ea5e9;
}
.switch input:checked::after {
  background: #ffffff;
  transform: translateX(17px);
}

.settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; }
.settings-card { padding: 20px 22px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); box-shadow: 0 2px 12px rgba(14, 165, 233, .06); }
.settings-card h3 { margin: 0 0 6px; font-size: 16px; font-weight: 700; color: var(--text); }
.settings-card > p { margin: 0 0 14px; color: var(--muted); font-size: 13px; line-height: 1.6; }
.setting-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(120px, auto); gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
.setting-row:last-child { border-bottom: 0; }
.setting-row span { color: var(--muted); font-size: 12px; line-height: 1.5; }
.setting-row strong { display: block; margin-bottom: 3px; color: var(--text); font-size: 13px; font-weight: 600; }
.setting-row input[type="number"],
.setting-row input[type="time"],
.setting-row select { width: 130px; }
.setting-row .time-pair { display: flex; align-items: center; gap: 7px; }
.setting-row .time-pair input { width: 92px; }
.radio-row { display: flex; gap: 7px; }
.radio-row label { padding: 6px 10px; border: 1px solid var(--line); border-radius: 7px; color: var(--muted); font-size: 12px; cursor: pointer; }
.radio-row input { width: auto; margin-right: 5px; accent-color: var(--green); }
.settings-save { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }
.settings-note { color: var(--muted); font-size: 12px; }

.section-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin: 0 0 16px; padding-bottom: 14px; border-bottom: 2px solid var(--line-soft); }
.section-title h3 { margin: 0; font-size: 17px; font-weight: 700; color: var(--text); }
.section-title > div > span { color: var(--muted); font-size: 12px; line-height: 1.5; display: block; margin-top: 4px; }
.section-empty { padding: 34px 18px; color: var(--muted); text-align: center; }
.small-muted { color: var(--muted); font-size: 12px; }
.status-good { color: var(--green-dark); }
.status-priority { color: var(--warning); }

.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgba(20, 22, 31, .42);
  backdrop-filter: blur(3px);
}
.modal {
  width: min(720px, 100%);
  max-height: min(780px, 92dvh);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel);
  box-shadow: var(--shadow);
}
.modal.small { width: min(520px, 100%); }
.modal.image-modal { width: min(900px, 96vw); background: #14161f; }
.modal-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 13px 15px; border-bottom: 1px solid var(--line-soft); }
.modal-head h2 { margin: 0; font-size: 16px; }
.modal-body { min-height: 0; overflow: auto; padding: 16px; }
.form-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
.form-grid label { display: grid; gap: 6px; color: var(--muted); font-size: 12px; font-weight: 500; }
.form-grid input, .form-grid select, .form-grid textarea { color: var(--text); font-size: 13px; }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
.image-view { display: grid; place-items: center; min-height: 360px; }
.image-view img { max-width: 100%; max-height: 72dvh; object-fit: contain; }
.bind-tools { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; margin-bottom: 12px; }
.bind-list { overflow: hidden; border: 1px solid var(--line); border-radius: 8px; }
.bind-item { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; gap: 9px; align-items: center; padding: 9px 11px; border-bottom: 1px solid var(--line-soft); }
.bind-item:last-child { border-bottom: 0; }
.bind-item input { width: auto; }
.bind-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.persona-list { display: grid; gap: 10px; }
.persona-card { padding: 13px; border: 1px solid var(--line); border-radius: 8px; }
.persona-card.active { border-color: #7dd3fc; background: var(--blue-soft); }
.persona-card h3 { margin: 0 0 5px; font-size: 14px; }
.persona-card p { margin: 0; color: var(--muted); font-size: 12px; }
.persona-actions { display: flex; gap: 8px; margin-top: 10px; }
.table-wrap { overflow: auto; }
table { width: 100%; border-collapse: collapse; }
th, td { padding: 9px; border-bottom: 1px solid var(--line-soft); text-align: left; font-size: 12px; white-space: nowrap; }
th { color: var(--muted); font-weight: 600; }

.toast-stack { position: fixed; z-index: 200; top: 16px; right: 16px; display: grid; gap: 7px; }
.toast { min-width: 220px; max-width: 360px; padding: 10px 12px; border-radius: 7px; background: #153b26; color: #fff; box-shadow: var(--shadow); font-size: 12px; }
.toast.error { background: #5b2528; }
.toast.warning { background: #6b4b00; }
.dashboard-feedback-button {
  position: fixed;
  right: 18px;
  bottom: 18px;
  z-index: 180;
  min-height: 40px;
  border: 1px solid #7dd3fc;
  border-radius: 999px;
  padding: 8px 14px;
  background: var(--panel);
  color: var(--blue-text);
  box-shadow: var(--shadow);
  font-weight: 750;
}
.dashboard-feedback-button:hover { background: var(--blue-soft); }
.dashboard-incident-list { display: grid; gap: 8px; }
.dashboard-incident-item { padding: 10px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--panel-soft); }
.dashboard-incident-item b { display: block; font-size: 12px; }
.dashboard-incident-item p { margin: 4px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
.dashboard-incident-item small { display: block; margin-top: 5px; color: var(--muted-soft); font-size: 9px; }
.dashboard-incident-item button { margin-top: 8px; }
.incident-timeline { display: grid; gap: 7px; }
.incident-event { padding: 8px 9px; border: 1px solid var(--line-soft); border-radius: 7px; background: var(--panel-soft); }
.incident-event b { display: block; font-size: 12px; }
.incident-event p { margin: 3px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
.incident-event img { display: block; width: 100%; max-width: 720px; margin-top: 8px; border: 1px solid var(--line); border-radius: 7px; }

/* 天空蓝 SaaS 皮肤：白色云朵卡片、天蓝状态和轻阴影 */
.app-sidebar {
  background: #ffffff;
  border-right: 1px solid #f8fafc;
  box-shadow: 0 2px 12px rgba(14, 165, 233, .04);
}
.app-brand {
  border-bottom: 1px solid #f8fafc;
}
.page-nav button.on {
  border-left: 3px solid #0ea5e9;
  background: linear-gradient(90deg, #f0f9ff, #ffffff);
  color: var(--blue-text);
}
.page-nav button:hover { background: var(--panel-soft); }
.customer.active { box-shadow: inset 2px 0 0 var(--green); }
.avatar { color: var(--muted); }
.messages { background: var(--bg); }
.composer-box:focus-within { box-shadow: 0 0 0 3px rgba(14, 165, 233, .12); }
.platform-label { color: var(--blue-text); }
.kind-label.kind-ai_generated,
.kind-label.kind-manual { color: var(--blue-text); }
.kind-label.kind-derived { background: var(--panel-soft); color: var(--muted); }
.contact-flag.warn { border-color: #fde68a; color: #92400e; }
.isolated-ok { color: var(--green); background: var(--green-soft); }
.rule-center-head {
  border-top: 1px solid #bae6fd;
  background: #ffffff;
  box-shadow: 0 2px 8px rgba(14, 165, 233, .08);
}
.rule-stat strong,
.rule-nav-count,
.profile-updated,
.rule-badge {
  font-variant-numeric: tabular-nums;
}
.rule-stat.ok { border-top: 3px solid var(--green); }
.rule-stat.error { border-top: 3px solid var(--danger); }
.rule-stat.warn { border-top: 3px solid var(--warning); }
.rule-stat:nth-child(2) { border-top: 3px solid #7dd3fc; }
.rule-badge.on::before,
.rule-badge.error::before,
.rule-badge.warn::before,
.rule-badge.info::before {
  content: "";
  width: 6px;
  height: 6px;
  flex: 0 0 6px;
  border-radius: 50%;
  background: currentColor;
}
.rule-card:hover {
  border-color: #bae6fd;
  background: #f8fafc;
}
.dashboard-feedback-button {
  border-color: #bae6fd;
  background: #ffffff;
  color: var(--blue-text);
}
.dashboard-feedback-button:hover { background: #f0f9ff; }
.customer-list::-webkit-scrollbar,
.messages::-webkit-scrollbar,
.profile-panel::-webkit-scrollbar,
.modal-body::-webkit-scrollbar,
.page-shell::-webkit-scrollbar { width: 8px; }
.customer-list::-webkit-scrollbar-thumb,
.messages::-webkit-scrollbar-thumb,
.profile-panel::-webkit-scrollbar-thumb,
.modal-body::-webkit-scrollbar-thumb,
.page-shell::-webkit-scrollbar-thumb { border-radius: 999px; background: #bae6fd; }
.customer-list::-webkit-scrollbar-thumb:hover,
.messages::-webkit-scrollbar-thumb:hover,
.profile-panel::-webkit-scrollbar-thumb:hover,
.modal-body::-webkit-scrollbar-thumb:hover,
.page-shell::-webkit-scrollbar-thumb:hover { background: #7dd3fc; }

@media (max-width: 1240px) {
  .app { grid-template-columns: 180px minmax(0, 1fr); }
  .session-layout { grid-template-columns: 300px minmax(0, 1fr); }
  .profile-panel {
    position: fixed;
    top: 10px;
    right: 10px;
    bottom: 10px;
    z-index: 60;
    width: min(330px, calc(100vw - 20px));
    box-shadow: var(--shadow);
    transform: translateX(calc(100% + 24px));
    transition: transform .18s ease;
  }
  .profile-panel.mobile-open { transform: translateX(0); }
  .mobile-profile-button { display: inline-flex; }
}
@media (max-width: 900px) {
  .app { grid-template-columns: 1fr; grid-template-rows: auto minmax(0, 1fr); }
  .app,
  .app-sidebar,
  .app-main,
  .page-panel,
  .page-shell,
  .page-inner {
    min-width: 0;
    max-width: 100%;
  }
  .app-sidebar { border-right: 0; border-bottom: 1px solid var(--line); }
  .app-brand { min-height: 58px; padding: 9px 12px; }
  .page-nav { display: flex; gap: 5px; padding: 7px 10px; overflow-x: auto; border-top: 1px solid var(--line-soft); }
  .page-nav button { width: auto; min-height: 36px; padding: 0 11px; white-space: nowrap; }
  .sidebar-tools { display: flex; position: absolute; top: 9px; right: 10px; padding: 0; border: 0; }
  .sidebar-tools button { min-height: 36px; padding: 0 8px; }
  .sidebar-tools #personaButton { display: none; }
  .session-layout { grid-template-columns: 1fr; padding: 7px; }
  .customer-panel {
    position: fixed;
    inset: 0 12% 0 0;
    z-index: 70;
    transform: translateX(-105%);
    transition: transform .18s ease;
    box-shadow: var(--shadow);
  }
  .customer-panel.mobile-open { transform: translateX(0); }
  .mobile-menu-button { display: inline-flex; }
  .chat-head { align-items: flex-start; flex-direction: column; }
  .chat-actions { justify-content: flex-start; }
  .message-block { max-width: 88%; }
  .page-shell { padding: 12px; }
  .page-head { flex-direction: column; }
  .settings-row { grid-template-columns: 1fr; }
  .program-rule-grid, .program-rule-test-row, .sticker-meaning-row { grid-template-columns: 1fr; }
  .sticker-meaning-row .icon-button { width: 100%; }
  .rule-center-head { flex-direction: column; }
  .rule-search { width: 100%; min-width: 0; }
  .rule-center-head-actions { justify-content: flex-start; }
  .rule-center-layout { grid-template-columns: 1fr; }
  .rule-center-nav { position: static; display: flex; overflow-x: auto; }
  .rule-nav-button { min-width: max-content; }
  .rule-summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rule-stat:nth-child(2) { border-right: 0; }
  .rule-stat:nth-child(-n+2) { border-bottom: 1px solid var(--line-soft); }
  .rule-help-strip { grid-template-columns: 1fr; }
  .rule-help-item { border-right: 0; border-bottom: 1px solid var(--line-soft); }
  .rule-help-item:last-child { border-bottom: 0; }
  #ruleRulesCard .toolbar,
  #ruleConflictCard .rule-filter-bar {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
  }
  #ruleRulesCard .section-title,
  #ruleConflictCard .rule-section-head {
    flex-direction: column;
    align-items: stretch;
  }
  #ruleRulesCard .toolbar input,
  #ruleRulesCard .toolbar select,
  #ruleRulesCard .toolbar button,
  #ruleConflictCard .rule-filter-bar select,
  #ruleConflictCard .rule-filter-bar button {
    width: 100%;
  }
  .rule-card {
    grid-template-columns: 1fr;
    gap: 9px;
    min-width: 0;
  }
  .rule-card-head { flex-direction: column; align-items: flex-start; }
  .rule-card-head > div { min-width: 0; }
  .rule-card-head,
  .rule-card > .rule-badge-row,
  .rule-card-actions {
    grid-column: 1;
  }
  .rule-card-actions { justify-content: flex-start; }
}
</style>
</head>
<body>

<div class="login-layer" id="loginView">
  <div class="login-card">
    <div class="login-brand">
      <div class="brand-mark">AI</div>
      <div>
        <h1>Aaiagent 客户看板</h1>
        <p>会话、图库、抽屉和设备设置都放在一个工作台里</p>
      </div>
    </div>
    <div class="login-row">
      <input id="passwordInput" type="password" placeholder="管理密码" autocomplete="current-password" autofocus>
      <button class="primary-button" id="loginButton">进入</button>
    </div>
    <div class="login-error" id="loginError"></div>
  </div>
</div>

<main class="app" id="appView" hidden>
  <aside class="app-sidebar">
    <div class="app-brand">
      <div class="brand-mark">AI</div>
      <div><strong>托管工作台</strong><span>统一客户与会话</span></div>
    </div>
    <nav class="page-nav" id="pageNav">
      <button data-page="session" class="on" onclick="showPage('session')"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/></svg>会话</button>
      <button data-page="library" onclick="showPage('library')"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>图库</button>
      <button data-page="drawers" onclick="showPage('drawers')"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/><circle cx="8" cy="6" r="1.5"/><circle cx="16" cy="12" r="1.5"/><circle cx="10" cy="18" r="1.5"/></svg>规则中心</button>
      <button data-page="kb" onclick="showPage('kb')"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>知识库</button>
      <button data-page="settings" onclick="showPage('settings')"><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-1.42 1.42-.06-.06A1.7 1.7 0 0 0 16.44 18a1.7 1.7 0 0 0-1 .56 1.7 1.7 0 0 0-.4 1.1V20h-2v-.34A1.7 1.7 0 0 0 12 18a1.7 1.7 0 0 0-1.54 1.66V20h-2v-.34A1.7 1.7 0 0 0 7.56 18a1.7 1.7 0 0 0-1.88.34l-.06.06-1.42-1.42.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.56-1 1.7 1.7 0 0 0-1.1-.4H2.6v-2h.34A1.7 1.7 0 0 0 4.6 10a1.7 1.7 0 0 0-.34-1.88l-.06-.06 1.42-1.42.06.06A1.7 1.7 0 0 0 7.56 7a1.7 1.7 0 0 0 1-.56 1.7 1.7 0 0 0 .4-1.1V5h2v.34A1.7 1.7 0 0 0 12 7a1.7 1.7 0 0 0 1.54-1.66V5h2v.34A1.7 1.7 0 0 0 16.44 7a1.7 1.7 0 0 0 1.88-.34l.06-.06 1.42 1.42-.06.06A1.7 1.7 0 0 0 19.4 10a1.7 1.7 0 0 0 .56 1 1.7 1.7 0 0 0 1.1.4h.34v2h-.34A1.7 1.7 0 0 0 19.4 15Z"/></svg>设置</button>
    </nav>
    <div class="sidebar-tools">
      <button id="personaButton">人设管理</button>
      <button id="tokenButton">设备密钥</button>
      <button id="logoutButton">退出登录</button>
    </div>
  </aside>

  <div class="app-main">
    <section class="page-panel on" id="page-session">
      <div class="session-layout">
        <aside class="panel customer-panel" id="sidebar">
          <div class="panel-head">
            <div class="panel-title-row">
              <div><h2>客户会话</h2><p>不同平台的同一个人会合在一起</p></div>
            </div>
            <div class="filters">
              <label class="wide"><input id="searchInput" type="search" placeholder="搜索昵称或聊天内容"></label>
              <label><select id="deviceSelect"><option value="">全部设备</option></select></label>
              <label><select id="platformSelect">
                <option value="">全部平台</option>
                <option value="soul">Soul</option>
                <option value="qq">QQ</option>
                <option value="immomo">陌陌</option>
                <option value="lianxin">连信</option>
              </select></label>
              <button class="icon-button" id="refreshButton" title="刷新数据">↻</button>
            </div>
            <div class="summary-row"><span id="customerSummary">0 位客户</span><span id="lastRefresh"></span></div>
          </div>
          <div class="customer-list" id="customerList"></div>
        </aside>

        <section class="panel chat">
          <header class="chat-head">
            <div class="chat-title-wrap">
              <div class="toolbar">
                <button class="ghost-button mobile-menu-button" id="mobileSidebarButton">客户列表</button>
                <button class="ghost-button mobile-profile-button" id="mobileProfileButton">客户资料</button>
              </div>
              <div class="chat-title-row">
                <div class="chat-title" id="chatTitle">请选择客户</div>
                <div class="platforms" id="chatPlatforms"></div>
              </div>
              <div class="chat-subtitle" id="chatSubtitle">从左侧选择客户查看完整对话</div>
              <div class="alias-strip" id="aliasStrip"></div>
            </div>
            <div class="chat-actions">
              <span class="action-status" id="actionStatus"></span>
              <button class="ghost-button" id="bindButton" disabled>关联账号</button>
              <button class="ghost-button priority-button" id="priorityButton" disabled>优先回复</button>
            </div>
          </header>
          <div class="messages" id="messages"><div class="empty-state">选择客户后查看跨平台完整对话</div></div>
          <div class="composer">
            <div class="composer-box">
              <textarea id="manualInput" placeholder="输入要原样发送的消息" disabled></textarea>
              <button class="primary-button" id="manualSendButton" disabled>优先发送</button>
            </div>
            <div class="composer-note" id="composerNote">人工消息会进入最高优先队列，手机端托管开启后优先发送。</div>
          </div>
        </section>

        <aside class="panel profile-panel" id="profilePanel">
          <div class="profile-head"><h2>客户资料</h2><p>统一身份、状态与接管记录</p></div>
          <div class="profile-hero">
            <div class="avatar" id="profileAvatar">客</div>
            <h3 id="profileName">请选择客户</h3>
            <p id="profileSubtitle">选择后查看客户资料</p>
          </div>
          <div class="profile-stats">
            <div class="stat"><strong id="profileMessageCount">0</strong><span>消息总数</span></div>
            <div class="stat"><strong id="profilePlatformCount">0</strong><span>平台账号</span></div>
          </div>
          <div class="profile-section">
            <h4>平台账号</h4>
            <div class="platform-links" id="profilePlatformLinks"></div>
          </div>
          <div class="profile-section">
            <h4>回复状态</h4>
            <div class="contact-flags" id="profileFlags"><span class="flag-none">正常回复中</span></div>
          </div>
          <div class="profile-section">
            <h4>人工接管</h4>
            <div class="profile-actions">
              <button class="ghost-button" id="takeoverBtn" onclick="setTakeover('manual')">人工接管</button>
              <button class="ghost-button" id="releaseBtn" onclick="setTakeover('ai')">放回 AI</button>
            </div>
          </div>
          <div class="profile-section">
            <h4>待人工 <span class="profile-updated" id="waitingCount"></span></h4>
            <div class="takeover-list" id="waitingList"><div class="flag-none">暂无等待</div></div>
          </div>
          <div class="profile-section">
            <h4>接管记录 <span class="profile-updated" id="takeoverCount"></span></h4>
            <div class="takeover-list" id="takeoverList"><div class="flag-none">暂无</div></div>
          </div>
          <div class="profile-section">
            <h4>身份档案 <span class="profile-updated" id="profileUpdated"></span></h4>
            <div class="profile-info"><span>姓名 / 称呼</span><b id="profileBasicName">未收集</b></div>
            <div class="profile-info"><span>所在城市</span><b id="profileLocationCity">未收集</b></div>
            <div class="profile-info"><span>家乡</span><b id="profileLocationHometown">未收集</b></div>
            <div class="profile-info"><span>学校 / 专业</span><b id="profileEducation">未收集</b></div>
            <div class="profile-info"><span>工作</span><b id="profileWork">未收集</b></div>
            <div class="profile-info"><span>家庭</span><b id="profileFamily">未收集</b></div>
            <div class="profile-info"><span>感情状态</span><b id="profileRelationship">未收集</b></div>
            <div class="profile-info"><span>喜欢</span><b id="profileLikes">未收集</b></div>
            <div class="profile-info"><span>不喜欢</span><b id="profileDislikes">未收集</b></div>
            <div class="profile-info"><span>近期动态</span><b id="profileRecent">未收集</b></div>
            <div class="profile-info"><span>备注</span><b id="profileNotes">未收集</b></div>
          </div>
          <div class="profile-section">
            <h4>当前状态</h4>
            <div class="profile-info"><span>回复优先</span><b id="profilePriority">普通</b></div>
            <div class="profile-info"><span>共享记忆</span><b class="status-good">正常</b></div>
            <div class="profile-info"><span>最后消息</span><b id="profileLastMessage">--</b></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="page-panel" id="page-library">
      <div class="page-shell">
        <div class="page-inner">
          <header class="page-head">
            <div><h2>图库</h2><p>管理 AI 按话题发送的图片</p></div>
            <button class="primary-button" id="createLibGroupButton">新建分组</button>
          </header>
          <div class="gallery-grid" id="libGrid"></div>
        </div>
      </div>
    </section>

    <section class="page-panel" id="page-drawers">
      <div class="page-shell">
        <div class="page-inner">
          <div class="rule-center-shell">
            <header class="rule-center-head">
              <div>
                <h2>规则中心</h2>
                <p>先看总览，再按分类管理；每条规则都标明管什么、谁使用、什么时候生效，有冲突会直接提醒。</p>
              </div>
              <label class="rule-search">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="ruleCenterSearch" type="search" placeholder="搜索规则、人设或关键词">
              </label>
              <div class="rule-center-head-actions">
                <label>当前人设
                  <select id="drawerPersona">
                    <option value="female_sutang">苏棠</option>
                    <option value="female">星暮</option>
                    <option value="male">阿杰</option>
                    <option value="male_chenyu">陈屿</option>
                  </select>
                </label>
                <span class="small-muted" id="personaPublishStatus"></span>
              </div>
            </header>
            <div class="rule-center-layout">
              <aside class="rule-center-nav" id="ruleCenterNav">
                <button class="rule-nav-button on" data-rule-tab="overview">规则总览 <span class="rule-nav-count" id="ruleNavOverviewCount"></span></button>
                <button class="rule-nav-button" data-rule-tab="rules">全部规则 <span class="rule-nav-count" id="ruleNavRulesCount"></span></button>
                <button class="rule-nav-button" data-rule-tab="conflicts">冲突提醒 <span class="rule-nav-count alert" id="ruleNavConflictCount"></span></button>
                <button class="rule-nav-button" data-rule-tab="persona">人设与资料 <span class="rule-nav-count" id="ruleNavPersonaCount"></span></button>
                <button class="rule-nav-button" data-rule-tab="execution">手机执行规则 <span class="rule-nav-count" id="ruleNavExecutionCount"></span></button>
              </aside>
              <main class="rule-center-main">
                <section class="rule-tab-panel on" id="rulePanelOverview">
                  <div class="rule-summary-grid">
                    <div class="rule-stat ok"><div class="rule-stat-top"><span class="rule-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span><span>正在生效</span></div><strong id="ruleSummaryActive">0</strong><small>会进入下一轮聊天</small><em>运行正常</em></div>
                    <div class="rule-stat"><div class="rule-stat-top"><span class="rule-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h8M8 12h8M8 18h5"/></svg></span><span>已停用</span></div><strong id="ruleSummaryDisabled">0</strong><small>保留但不执行</small><em>可随时恢复</em></div>
                    <div class="rule-stat error"><div class="rule-stat-top"><span class="rule-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20L12 3Zm0 6v5m0 3h.01"/></svg></span><span>严重冲突</span></div><strong id="ruleSummaryErrors">0</strong><small>可能互相打架</small><em>优先处理</em></div>
                    <div class="rule-stat warn"><div class="rule-stat-top"><span class="rule-stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5m0 3h.01M4 4l16 16"/></svg></span><span>需要确认</span></div><strong id="ruleSummaryWarnings">0</strong><small>范围或内容重叠</small><em>建议检查</em></div>
                  </div>
                  <div class="rule-help-strip">
                    <div class="rule-help-item"><b>先看冲突</b><span>红色和黄色提醒会告诉你哪两条规则可能打架。</span></div>
                    <div class="rule-help-item"><b>再改规则</b><span>点编辑、停用或删除，保存后下一条聊天立即生效。</span></div>
                    <div class="rule-help-item"><b>最后试聊</b><span>用同一个问题同时看 A、B 两个模型怎么回答。</span></div>
                  </div>
                </section>
          <section class="settings-card rule-tab-panel" id="ruleSharedFactsCard">
            <div class="section-title">
              <div>
                <h3>共享人物资料 <span class="profile-updated" id="sharedPersonaVersion"></span></h3>
                <span>4 套人设所有设备共用；这里保存后，所有使用这套人设的手机都会更新</span>
              </div>
              <button class="primary-button" id="saveSharedFactsButton">保存共享资料</button>
            </div>
            <div class="form-grid">
              <label>年龄方式
                <select id="sharedFactsAgeMode">
                  <option value="fixed_age">固定年龄</option>
                  <option value="birth_year">出生年份</option>
                </select>
              </label>
              <label>固定年龄<input id="sharedFactsFixedAge" type="number" min="18" max="80" placeholder="例如：29"></label>
              <label>出生年份<input id="sharedFactsBirthYear" type="number" min="1900" max="2099" placeholder="例如：1997"></label>
              <label>婚姻状态
                <select id="sharedFactsMarital">
                  <option value="single">未婚</option>
                  <option value="married">已婚</option>
                  <option value="divorced">离异</option>
                </select>
              </label>
              <label>是否有孩子
                <select id="sharedFactsHasChildren">
                  <option value="false">没有孩子</option>
                  <option value="true">有孩子</option>
                </select>
              </label>
              <label>孩子年龄<input id="sharedFactsChildrenAge" type="number" min="0" max="80" placeholder="例如：3"></label>
              <label>QQ号<input id="sharedFactsQq" inputmode="numeric" placeholder="5 到 12 位数字，可留空"></label>
              <label>老家/籍贯<input id="sharedFactsHometown" placeholder="例如：重庆"></label>
              <label>现居城市<input id="sharedFactsCurrentCity" placeholder="例如：重庆"></label>
              <label>现居区县<input id="sharedFactsCurrentDistrict" placeholder="例如：两江新区"></label>
              <label>常用区域或地标<input id="sharedFactsCommonArea" placeholder="可选，例如：观音桥附近"></label>
              <label>工作城市<input id="sharedFactsWorkCity" placeholder="例如：重庆"></label>
              <label>工作区域<input id="sharedFactsWorkDistrict" placeholder="例如：江北区"></label>
              <label>位置公开精度
                <select id="sharedFactsLocationPrecision">
                  <option value="city">只说城市</option>
                  <option value="district">只说到区县</option>
                  <option value="landmark">可说到地标</option>
                </select>
              </label>
              <label>主动提位置
                <select id="sharedFactsProactiveLocation">
                  <option value="false">不允许主动提</option>
                  <option value="true">允许主动提</option>
                </select>
              </label>
            </div>
            <div class="small-muted" id="sharedFactsStatus">手机端不再单独修改这些资料。</div>
          </section>
          <div class="agent-overview-grid rule-tab-panel" id="ruleOverviewGrid">
            <section class="settings-card">
              <h3>现在这个 Agent 是谁</h3>
              <div id="agentIdentitySummary" class="agent-summary"></div>
            </section>
            <section class="settings-card">
              <h3>冲突提醒</h3>
              <div id="agentConflicts" class="conflict-list"></div>
            </section>
          </div>
          <section class="settings-card rule-tab-panel" id="personaAuditCard">
            <div class="section-title">
              <div><h3>4 套人设隔离检查</h3><span>检查正文、资料和卡片有没有混入其他人设的身份、工作或家庭信息</span></div>
              <button class="ghost-button" id="runPersonaAuditButton">开始检查</button>
            </div>
            <div id="personaAuditResult" class="small-muted">还没有检查。</div>
          </section>
          <section class="settings-card agent-editor-card rule-tab-panel" id="rulePersonaEditorCard">
            <div class="section-title">
              <div><h3>人设正文</h3><span>这里负责她是谁、性格、整体表达方式</span></div>
              <button class="primary-button" id="savePersonaPromptButton">保存人设正文</button>
            </div>
            <label class="drawer-field">人设名字<input id="personaNameEditor" placeholder="例如：苏棠"></label>
            <textarea id="personaPromptEditor" class="persona-prompt-editor" placeholder="写她是谁、性格、工作、整体怎么说话..."></textarea>
            <div class="small-muted" id="personaPromptStatus"></div>
          </section>
          <section class="settings-card rule-tab-panel" id="rulePromptOrderCard">
            <div class="section-title"><h3>发送顺序</h3><span>所有模型看到的顺序都一样</span></div>
            <div id="agentPromptOrder" class="prompt-order"></div>
          </section>
          <section class="settings-card agent-test-card rule-tab-panel" id="ruleAgentTestCard">
            <div class="section-title">
              <div><h3>双模型试聊</h3><span>同一套人设和卡片，同时看 A、B 两边怎么回答</span></div>
              <button class="primary-button" id="runAgentTestButton">开始试聊</button>
            </div>
            <textarea id="agentTestQuestions" class="persona-prompt-editor" placeholder="每行一个问题，例如：你孩子几岁？">你今年多大？
你孩子几岁？
你最讨厌别人做什么？
你会主动给联系方式吗？</textarea>
            <div id="agentTestResults" class="agent-test-results"></div>
          </section>
          <section class="settings-card program-rules-card rule-tab-panel" id="ruleExecutionCard">
            <div class="section-title">
              <div><h3>程序规则 <span class="profile-updated" id="programRulesStatus"></span></h3><span>这里改完保存，下一条聊天按新内容执行；系统固定识别格式仍由程序保护</span></div>
              <button class="primary-button" id="saveProgramRulesButton">保存程序规则</button>
            </div>
            <div class="program-rule-block">
              <div class="program-rule-title">
                <div>
                  <b>我的安全底线</b>
                  <span>这里是给模型执行的安全要求；可以停用或清空，保存后下一条聊天立即生效</span>
                </div>
                <div class="toolbar">
                  <label class="switch"><input id="programSafetyBoundaryEnabled" type="checkbox">启用</label>
                  <button class="ghost-button small-button danger-text" id="deleteProgramSafetyBoundaryButton">删除</button>
                </div>
              </div>
              <label class="program-rule-field">
                安全底线文字
                <textarea id="programSafetyBoundary" class="program-rule-voice-instruction" placeholder="写清楚所有模型都必须遵守的安全底线"></textarea>
              </label>
            </div>
            <div class="program-rule-block">
              <div class="program-rule-title">
                <div>
                  <b>平台提示和系统通知</b>
                  <span>一行写一个。出现这些内容时，程序会在送给模型前先丢掉，不当作客户消息。</span>
                </div>
                <div class="toolbar">
                  <label class="switch"><input id="programPlatformNoticeEnabled" type="checkbox">启用</label>
                  <button class="ghost-button small-button danger-text" id="deleteProgramPlatformNoticeButton">删除</button>
                </div>
              </div>
              <label class="program-rule-field">
                系统提示文字
                <textarea id="programPlatformNoticeMarkers" class="program-rule-markers" placeholder="一行一个，例如：&#10;对方正在输入&#10;系统通知&#10;已读回执"></textarea>
              </label>
            </div>
            <div class="program-rule-block">
              <div class="program-rule-title">
                <div>
                  <b>没有转出文字的语音</b>
                  <span>手机发来语音但拿不到文字时，按你选的方式处理。</span>
                </div>
                <div class="toolbar">
                  <label class="switch"><input id="programVoiceEnabled" type="checkbox">启用</label>
                  <button class="ghost-button small-button danger-text" id="deleteProgramVoiceButton">删除</button>
                </div>
              </div>
              <div class="program-rule-grid">
                <label class="program-rule-field">
                  处理方式
                  <select id="programVoiceMode">
                    <option value="redirect">照常聊别的，不提听不清</option>
                    <option value="ignore">直接跳过，不回</option>
                    <option value="fixed_reply">固定回一句</option>
                  </select>
                </label>
                <label class="program-rule-field">
                  固定回复
                  <input id="programVoiceFixedReply" placeholder="只在“固定回一句”时使用">
                </label>
              </div>
              <label class="program-rule-field">
                给模型的执行文字
                <textarea id="programVoiceInstruction" class="program-rule-voice-instruction" placeholder="例如：不许说听不清，也不许假装听到了内容"></textarea>
              </label>
            </div>
            <div class="program-rule-block">
              <div class="program-rule-title">
                <div>
                  <b>互动表情和表情包</b>
                  <span>程序先把图案翻译成意思，再交给模型。左边写表情名字，右边写它代表什么。</span>
                </div>
                <div class="toolbar">
                  <label class="switch"><input id="programStickerEnabled" type="checkbox">启用</label>
                  <button class="ghost-button small-button danger-text" id="deleteProgramStickerButton">删除</button>
                </div>
              </div>
              <label class="program-rule-field">
                给模型的执行文字
                <textarea id="programStickerInstruction" placeholder="例如：表情只是虚拟表情，不许当成真实动作"></textarea>
              </label>
              <div>
                <div class="program-rule-title" style="margin-bottom:7px">
                  <div><b>表情含义</b><span class="program-rule-help">最多200个，未填写的表情仍会原样保留名称。</span></div>
                  <button class="ghost-button small-button" id="addStickerMeaningButton">新增一行</button>
                </div>
                <div id="stickerMeaningRows" class="sticker-meaning-list"></div>
              </div>
            </div>
            <div class="program-rule-block">
              <div class="program-rule-title">
                <div><b>试一下</b><span>不会真的发消息，只告诉你程序会丢掉、跳过还是怎么改。</span></div>
              </div>
              <div class="program-rule-test-row">
                <input id="programRuleTestInput" placeholder="例如：【平台提示】对方正在输入……">
                <button class="ghost-button" id="runProgramRuleTestButton">检查</button>
              </div>
              <div id="programRuleTestResult" class="program-rule-test-result"></div>
            </div>
          </section>
          <section class="rule-section rule-tab-panel" id="ruleConflictCard">
            <div class="rule-section-head">
              <div>
                <h3>冲突提醒 <span class="profile-updated" id="ruleConflictCount"></span></h3>
                <p>这里只做提醒，不会阻止你保存或删除。红黄提醒点开后可以直接编辑或停用相关规则。</p>
              </div>
              <div class="rule-filter-bar">
                <select id="ruleConflictLevelFilter">
                  <option value="">全部冲突</option>
                  <option value="error">只看会打架</option>
                  <option value="warn">只看范围重叠</option>
                  <option value="info">只看重复和相近</option>
                </select>
                <button class="ghost-button small-button" id="refreshAgentRulesConflictButton">重新检查</button>
              </div>
            </div>
            <div id="agentRuleConflictList" class="rule-conflict-list"></div>
          </section>
          <section class="settings-card legacy-rules-card rule-tab-panel" id="ruleRulesCard">
            <div class="section-title">
              <div><h3>全部规则 <span class="profile-updated" id="legacyRuleCount"></span></h3><span>每条规则都能编辑、停用或删除；保存后下一条聊天立即使用新状态</span></div>
              <div class="toolbar">
                <input id="legacyRuleSearch" type="search" placeholder="搜索规则">
                <select id="agentRuleGateFilter">
                  <option value="">全部时机</option>
                  <option value="input">收到消息先处理</option>
                  <option value="prompt">给大模型看的内容</option>
                  <option value="output">回复发出前检查</option>
                  <option value="execution">系统直接执行</option>
                </select>
                <select id="agentRuleStatusFilter">
                  <option value="">全部状态</option>
                  <option value="enabled">只看正在生效</option>
                  <option value="disabled">只看已停用</option>
                </select>
                <select id="agentRuleConflictFilter">
                  <option value="">全部规则</option>
                  <option value="error">只看会打架</option>
                  <option value="warn">只看范围重叠</option>
                  <option value="info">只看重复或相近</option>
                </select>
                <button class="primary-button" id="createAgentRuleButton">新增规则</button>
              </div>
            </div>
            <div id="legacyAgentRules" class="legacy-rule-list"></div>
          </section>
              </main>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="page-panel" id="page-kb">
      <div class="page-shell">
        <div class="page-inner">
          <header class="page-head">
            <div><h2>人设知识库</h2><p>每个知识库只属于当前人设；命中的知识卡会优先进入本轮回复</p></div>
            <div class="toolbar">
              <label>人设
                <select id="knowledgePersona">
                  <option value="female_sutang">苏棠</option>
                  <option value="female">星暮</option>
                  <option value="male">阿杰</option>
                  <option value="male_chenyu">陈屿</option>
                </select>
              </label>
              <button class="primary-button" id="createAgentCardButton">新增知识卡</button>
              <span class="small-muted" id="drawerCount"></span>
            </div>
          </header>
          <div class="drawer-grid" id="drawerCards"></div>
        </div>
      </div>
    </section>

    <section class="page-panel" id="page-settings">
      <div class="page-shell">
        <div class="page-inner">
          <header class="page-head">
            <div><h2>设置</h2><p>这里改完会同步到对应手机</p></div>
            <div class="toolbar">
              <button class="ghost-button" id="settingsPersonaButton">人设管理</button>
              <label>设备
                <select id="settingsDeviceSelect"><option value="">请选择设备</option></select>
              </label>
            </div>
          </header>
          <div class="settings-grid">
            <section class="settings-card">
              <h3>托管开关</h3>
              <p>决定手机会不会自动回复，以及会不会把聊天同步到看板。</p>
              <div class="setting-row">
                <span><strong>AI 自动回复</strong>关掉后只同步，不自动回</span>
                <label class="switch"><input id="hostingEnabled" type="checkbox">启用</label>
              </div>
              <div class="setting-row">
                <span><strong>监控同步</strong>把手机上的聊天记录同步过来</span>
                <label class="switch"><input id="monitorEnabled" type="checkbox">启用</label>
              </div>
              <div class="setting-row">
                <span><strong>天气信息</strong>允许聊天时参考天气</span>
                <label class="switch"><input id="weatherEnabled" type="checkbox">启用</label>
              </div>
              <div class="setting-row">
                <span><strong>时间信息</strong>允许聊天时参考当前时间</span>
                <label class="switch"><input id="timeEnabled" type="checkbox">启用</label>
              </div>
            </section>
            <section class="settings-card">
              <h3>回复节奏</h3>
              <p>调回复前的等待时间，0 就是不额外等待。</p>
              <div class="setting-row">
                <span><strong>默认平台</strong>手机主要工作的平台</span>
                <select id="settingsPlatform">
                  <option value="soul">Soul</option>
                  <option value="qq">QQ</option>
                  <option value="immomo">陌陌</option>
                  <option value="lianxin">连信</option>
                </select>
              </div>
              <div class="setting-row">
                <span><strong>回复前等待秒数</strong>0 到 300 秒</span>
                <input id="paceInput" type="number" min="0" max="300" value="0">
              </div>
              <div class="setting-row">
                <span><strong>AI 值班时间</strong>到点睡觉，起床后交回 AI</span>
                <label class="switch"><input id="aiHoursEnabled" type="checkbox">启用</label>
              </div>
              <div class="setting-row">
                <span><strong>值班时段</strong>开始和结束小时</span>
                <div class="time-pair">
                  <input id="aiStartHour" type="number" min="0" max="23" value="8">
                  <span>到</span>
                  <input id="aiEndHour" type="number" min="0" max="23" value="23">
                </div>
              </div>
            </section>
            <section class="settings-card">
              <h3>线路</h3>
              <p>只显示线路名字，不需要记模型名。</p>
              <div class="setting-row">
                <span><strong>当前线路</strong>聊天遇到问题时可以切换</span>
                <div class="radio-row">
                  <label><input id="lineA" type="radio" name="line" onclick="setModelRoute('a')">线路 A</label>
                  <label><input id="lineB" type="radio" name="line" onclick="setModelRoute('b')">线路 B</label>
                </div>
              </div>
            </section>
            <section class="settings-card">
              <div class="section-title">
                <div><h3>最近网站问题</h3><span>自动记录页面报错和请求失败；也可以用右下角按钮手动反馈</span></div>
                <div class="toolbar">
                  <button class="ghost-button" id="runReplayCasesButton">执行回放题库</button>
                  <button class="ghost-button" id="refreshDashboardIncidentsButton">刷新</button>
                </div>
              </div>
              <div id="dashboardIncidentList" class="dashboard-incident-list">
                <div class="flag-none">还没有网站故障记录。</div>
              </div>
            </section>
          </div>
          <div class="settings-save">
            <span class="settings-note" id="settingsNote">选择设备后可以修改。</span>
            <button class="primary-button" id="hostingSaveBtn" onclick="saveHostingConfig()">保存设置</button>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>

<input id="libraryUploadInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden>

<div class="modal-layer" id="libraryGroupModal" hidden>
  <div class="modal small">
    <div class="modal-head"><h2 id="libraryGroupModalTitle">新建分组</h2><button class="ghost-button" data-close="libraryGroupModal">关闭</button></div>
    <div class="modal-body">
      <div class="form-grid">
        <label>分组名字<input id="libGroupName" placeholder="例如：周末生活照"></label>
        <label>对方说到这些词才使用（用逗号分隔）<textarea id="libGroupKeywords" placeholder="想看看周末, 发张生活照"></textarea></label>
        <label>给人设使用
          <select id="libGroupPersona">
            <option value="">所有人设通用</option>
            <option value="female_sutang">苏棠</option>
            <option value="female">星暮</option>
            <option value="male">阿杰</option>
            <option value="male_chenyu">陈屿</option>
          </select>
        </label>
        <label>给平台使用
          <select id="libGroupPlatform">
            <option value="">全部平台</option>
            <option value="soul">Soul</option>
            <option value="qq">QQ</option>
            <option value="immomo">陌陌</option>
            <option value="lianxin">连信</option>
          </select>
        </label>
      </div>
      <div class="modal-actions">
        <button class="ghost-button" data-close="libraryGroupModal">取消</button>
        <button class="primary-button" id="saveLibGroupButton">保存分组</button>
      </div>
    </div>
  </div>
</div>

<div class="modal-layer" id="mediaPreviewModal" hidden>
  <div class="modal image-modal">
    <div class="modal-head"><h2 id="mediaPreviewTitle">图片预览</h2><button class="ghost-button" data-close="mediaPreviewModal">关闭</button></div>
    <div class="modal-body image-view"><img id="mediaPreviewImage" alt="图库图片" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="></div>
  </div>
</div>

<div class="modal-layer" id="agentCardModal" hidden>
  <div class="modal small">
    <div class="modal-head"><h2>新增知识卡</h2><button class="ghost-button" data-close="agentCardModal">关闭</button></div>
    <div class="modal-body">
      <div class="form-grid">
        <label>卡片名字<input id="agentCardName" placeholder="例如：孩子年龄"></label>
        <label>卡片类型
          <select id="agentCardKind">
            <option value="identity">身份事实</option>
            <option value="speech">说话方式</option>
            <option value="policy">禁止事项</option>
            <option value="lore">生活素材</option>
            <option value="scene">场景素材</option>
            <option value="counter">接话技巧</option>
          </select>
        </label>
        <label>什么时候生效
          <select id="agentCardActivation">
            <option value="always">一直生效</option>
            <option value="keyword">说到关键词才生效</option>
          </select>
        </label>
        <label>说话方式
          <select id="agentCardReplyMode">
            <option value="guide">参考表达，允许模型自然改写</option>
            <option value="exact">优先按原文说，尽量不改写</option>
          </select>
        </label>
        <label>优先级<input id="agentCardPriority" type="number" min="-100" max="100" value="0"></label>
        <label>触发词（说到才生效时填写，用逗号分隔）<input id="agentCardKeywords" placeholder="冷场, 被夸, 问年龄"></label>
        <label>卡片内容<textarea id="agentCardContent" placeholder="写清楚模型必须怎么理解、怎么处理"></textarea></label>
      </div>
      <div class="modal-actions">
        <button class="ghost-button" data-close="agentCardModal">取消</button>
        <button class="primary-button" id="saveAgentCardButton">保存卡片</button>
      </div>
    </div>
  </div>
</div>

<div class="modal-layer" id="agentRuleModal" hidden>
  <div class="modal small">
    <div class="modal-head"><h2 id="agentRuleModalTitle">新增规则</h2><button class="ghost-button" data-close="agentRuleModal">关闭</button></div>
    <div class="modal-body">
      <div class="form-grid">
        <label>规则名字<input id="agentRuleName" placeholder="例如：年龄必须固定"></label>
        <label>什么时候执行
          <select id="agentRuleGate">
            <option value="input">收到消息后先处理</option>
            <option value="prompt">给大模型看，让它照做</option>
            <option value="output">回复发出前检查或纠正</option>
            <option value="execution">系统直接执行</option>
          </select>
        </label>
        <label>优先级<input id="agentRulePriority" type="number" min="1" max="100" value="50"></label>
        <label>作用范围
          <select id="agentRulePersona">
            <option value="">全部人设</option>
            <option value="female">仅星暮</option>
            <option value="female_sutang">仅苏棠</option>
            <option value="male">仅阿杰</option>
            <option value="male_chenyu">仅陈屿</option>
          </select>
        </label>
        <label>状态
          <select id="agentRuleEnabled">
            <option value="true">启用</option>
            <option value="false">停用</option>
          </select>
        </label>
        <label>规则内容<textarea id="agentRuleDetail" placeholder="写清楚这条规则要解决什么、什么时候生效、不能怎么做"></textarea></label>
      </div>
      <div class="modal-actions">
        <button class="ghost-button" data-close="agentRuleModal">取消</button>
        <button class="primary-button" id="saveAgentRuleButton">保存规则</button>
      </div>
    </div>
  </div>
</div>

<div class="modal-layer" id="bindModal" hidden>
  <div class="modal">
    <div class="modal-head"><h2>关联同一客户的平台账号</h2><button class="ghost-button" data-close="bindModal">关闭</button></div>
    <div class="modal-body">
      <div class="bind-tools">
        <input id="bindNameInput" placeholder="统一显示名称，例如：王先生">
        <button class="primary-button" id="saveBindButton">保存关联</button>
      </div>
      <input id="bindSearchInput" type="search" placeholder="筛选平台账号或昵称">
      <div class="small-muted" id="bindHint" style="margin:10px 0"></div>
      <div class="bind-list" id="bindList"></div>
    </div>
  </div>
</div>

<div class="modal-layer" id="personaModal" hidden>
  <div class="modal small">
    <div class="modal-head"><h2>人设管理</h2><button class="ghost-button" data-close="personaModal">关闭</button></div>
    <div class="modal-body persona-list" id="personaList"></div>
  </div>
</div>

<div class="modal-layer" id="tokenModal" hidden>
  <div class="modal small">
    <div class="modal-head"><h2>设备密钥</h2><button class="ghost-button" data-close="tokenModal">关闭</button></div>
    <div class="modal-body table-wrap" id="tokenList"></div>
  </div>
</div>

<div class="modal-layer" id="dashboardIncidentModal" hidden>
  <div class="modal">
    <div class="modal-head">
      <h2 id="dashboardIncidentTitle">网站问题详情</h2>
      <div class="toolbar">
        <button class="primary-button small-button" id="createDashboardReplayButton" type="button">生成回放测试</button>
        <button class="icon-button" type="button" data-close="dashboardIncidentModal">×</button>
      </div>
    </div>
    <div class="modal-body">
      <div class="toolbar" style="margin-bottom:12px">
        <select id="dashboardIncidentStatus">
          <option value="new">新问题</option>
          <option value="processing">处理中</option>
          <option value="fixed">已修复</option>
          <option value="verified">已验证</option>
        </select>
        <button class="ghost-button" id="saveDashboardIncidentStatusButton">保存状态</button>
      </div>
      <div id="dashboardIncidentDetail" class="incident-timeline"></div>
    </div>
  </div>
</div>

<button class="dashboard-feedback-button" id="dashboardFeedbackButton" type="button">记录网站问题</button>
<div class="toast-stack" id="toastStack"></div>
<script src="app.js"></script>
</body>
</html>
